# R8 rules for the UII watch app. AGP merges every file in src/main/keepRules.
#
# Manifest components (activities, services, receivers) are kept automatically, and WorkManager and Compose bring their
# own consumer rules. What is added here is only what this app relies on by name.

# Readable stack traces from release builds.
-keepattributes SourceFile,LineNumberTable

# Health Services starts this service by the class name registered with it, not from the manifest alone.
-keep class com.example.watchtest.uii.HealthPassiveService { *; }

# The workers are created by WorkManager from a class name stored in its database.
-keep class com.example.watchtest.uii.UploadWorker { <init>(...); }
